#!/usr/bin/env bash
set -euo pipefail

### DESCRIPTION
# this script sets up custom keybindings for the Ptyxis terminal emulator.
# It configures keybindings to launch specific commands in new Ptyxis tabs,
# each associated with a different project directory and Neovim server instance.
#
# Actions Configured:
# - Ctrl+Alt+0: Opens pi-agent in project working directory (using select_project script).
# - Ctrl+Alt+1: Opens dotfiles project (using ptyxis_nvim_project script).
# - Ctrl+Alt+2: Opens tbx project.
# - Ctrl+Alt+3: Opens accounts project.
# - Ctrl+Alt+4: Opens dots project.
#
# Guardrails:
# Aborts if executed inside a container (/run/.containerenv), ensuring it
# configures GNOME settings properly on the host system.
# ptyxis_keybinds
#
LOG="$HOME/Projects/ptyxis-setup.log"
touch "$LOG"
echo "Setting up keybindings for Ptyxis..." | tee -a "$LOG"
# guardrail:
if [ -f /run/.containerenv ]; then
  ERROR_MSG="This script is intended to be run on the host system, not inside a toolbox/podman container."
  echo "Error: $ERROR_MSG" | tee -a "$LOG"
  exit 1
fi

echo " ---------------------------------------"
echo " Setup the keybinds for ptyxis          "
echo " ---------------------------------------"
# gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings
PTYXIS="/org/gnome/Ptyxis"
PROFILE_UUID=$(dconf read "${PTYXIS}/default-profile-uuid" | tr -d "'")
KEY=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings
BASE_DIR="${KEY}/"
dconf reset -f ${BASE_DIR}

# Generate the VALUE string for dconf write custom-keybindings dynamically
VALUE="["
for i in {0..4}; do
  VALUE+="'${BASE_DIR}custom${i}/'"
  if [ $i -lt 4 ]; then
    VALUE+=", "
  fi
done
VALUE+="]"

echo "Setting keybindings to: $VALUE"
dconf write "$KEY" "$VALUE"

PROJECT=pi-agent
DIR=${HOME}/Projects
TITLE="pi-agent"
dconf write "${BASE_DIR}custom0/name" "'${TITLE}'"
dconf write "${BASE_DIR}custom0/binding" "'<Control><Alt>0'"
dconf write "${BASE_DIR}custom0/command" "'ptyxis --standalone --maximize --fullscreen --title=${TITLE} --working-directory=${DIR} --tab-with-profile=${PROFILE_UUID} -- select_project'"

# Define projects in order (indices 1 through 4)
PROJECTS=("dotfiles" "tbx" "accounts" "dots")

# Loop through the array, incrementing the custom index and the keybind index
for i in "${!PROJECTS[@]}"; do
  PROJECT="${PROJECTS[$i]}"
  IDX=$((i + 1))
  CUSTOM="${BASE_DIR}custom${IDX}/"
  TITLE="dev-${PROJECT}-repo"

  dconf write "${CUSTOM}name" "'${TITLE}'"
  dconf write "${CUSTOM}binding" "'<Control><Alt>${IDX}'"
  dconf write "${CUSTOM}command" "'ptyxis_nvim_project ${PROJECT}'"
done

dconf dump "$BASE_DIR" | tee -a "$LOG"
